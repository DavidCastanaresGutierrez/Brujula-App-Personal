NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo en el servidor: credenciales revocables del reloj Wear OS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Análisis de fotos de comida. Cualquier servicio compatible con la API de chat de OpenAI.
# Por defecto apunta al nivel gratuito de Groq; consulta README.md para Mistral, OpenRouter o Gemini.
VISION_API_KEY=your-vision-api-key
# Opcionales. Valores por defecto: Groq y meta-llama/llama-4-scout-17b-16e-instruct.
# VISION_BASE_URL=https://api.groq.com/openai/v1
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Compatibilidad: si solo existe GEMINI_API_KEY se usa Gemini (de pago en la UE desde marzo de 2026).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
